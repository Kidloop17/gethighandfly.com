---
import Base from '../../layouts/Base.astro';
import { getLangFromUrl, LANGS, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
import { getCollection } from 'astro:content';
import HeroSection from '../../components/sections/HeroSection.astro';
import IntroSection from '../../components/sections/IntroSection.astro';
import DisciplinesSection from '../../components/sections/DisciplinesSection.astro';
import SpotSection from '../../components/sections/SpotSection.astro';
import PartnersSection from '../../components/sections/PartnersSection.astro';
import VolunteersSection from '../../components/sections/VolunteersSection.astro';
import ArchiveSection from '../../components/sections/ArchiveSection.astro';
import RegistrationSection from '../../components/sections/RegistrationSection.astro';
import FooterSection from '../../components/sections/FooterSection.astro';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

// Текущий сезон (самый свежий)
const seasons = (await getCollection('seasons')).sort((a, b) => b.data.year - a.data.year);
const currentSeason = seasons[0];
---

<Base lang={lang} title={t('site.title')} description={t('site.description')}>
  <HeroSection lang={lang} startDate={currentSeason?.data.dates?.start} />
  <IntroSection lang={lang} />
  <DisciplinesSection lang={lang} />
  <SpotSection lang={lang} />
  <PartnersSection lang={lang} />
  <VolunteersSection lang={lang} />
  <ArchiveSection lang={lang} />
  <RegistrationSection lang={lang} status={currentSeason?.data.status} />
  <FooterSection lang={lang} />
</Base>
