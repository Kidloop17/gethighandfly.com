---
import '../styles/tokens.css';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import LanguageSwitcher from '../components/ui/LanguageSwitcher.astro';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title = 'Get High And Fly', description = '' } = Astro.props;
const t = useTranslations(lang);

// Astro.site is undefined when `site` is not set in astro.config.mjs
// Use a fallback so build doesn't fail; replace with real domain in production
const siteBase = Astro.site ?? new URL('https://gethighandfly.com');
const canonicalURL = new URL(Astro.url.pathname, siteBase);

const locales = ['en', 'ru', 'vi'];
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {locales.map((l) => (
      <link
        rel="alternate"
        hreflang={l}
        href={new URL(`/${l}/`, siteBase)}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL('/en/', siteBase)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Playfair+Display:wght@400;700&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-nav">
      <a href={`/${lang}/`} class="site-logo">GHAF</a>
      <nav class="site-nav-links">
        <a href="#archive">{t('nav.archive')}</a>
        <a href="#registration" class="btn-nav">{t('nav.register')}</a>
      </nav>
      <LanguageSwitcher current={lang} />
    </header>
    <slot />
    <script>
      // Scroll-reveal (runs once on page load)
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('revealed');
            revealObserver.unobserve(e.target);
          }
        });
      }, { threshold: 0.1 });
      document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
    </script>
  </body>
</html>
<style is:global>
  body {
    font-family: var(--font-body);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-body);
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-display);
    letter-spacing: 0.02em;
    line-height: 1.1;
  }

  /* Scroll-reveal */
  .reveal {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal.revealed {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Focus ring */
  :focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* Section divider stripes */
  .stripe-coral {
    height: 4px;
    background: var(--color-accent);
  }
  .stripe-ocean {
    height: 4px;
    background: var(--color-ocean);
  }
</style>
<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: var(--space-l);
    padding: var(--space-m) var(--space-l);
    background: var(--color-bg-dark);
    border-bottom: 1px solid rgba(245,233,204,0.08);
  }
  .site-logo {
    font-family: var(--font-display);
    font-size: 1.75rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--color-accent);
    flex-shrink: 0;
  }
  .site-nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    margin-left: auto;
  }
  .site-nav-links a {
    font-family: var(--font-body);
    color: var(--color-text-on-dark);
    text-decoration: none;
    opacity: 0.75;
    font-size: 0.9375rem;
    font-weight: 600;
    transition: opacity var(--transition);
  }
  .site-nav-links a:hover {
    opacity: 1;
  }
  .btn-nav {
    background: var(--color-accent) !important;
    color: #fff !important;
    opacity: 1 !important;
    padding: 0.4rem 1rem;
    border-radius: var(--radius);
    font-weight: 600;
    transition: background var(--transition) !important;
  }
  .btn-nav:hover {
    background: var(--color-accent-hover) !important;
  }

  @media (max-width: 600px) {
    .site-nav-links a:not(.btn-nav) {
      display: none;
    }
    .site-nav {
      gap: var(--space-m);
    }
  }
</style>
