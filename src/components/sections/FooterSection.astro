---
import type { Lang } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import LanguageSwitcher from '../ui/LanguageSwitcher.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---
<!-- Poster-border stripe: alternating coral | ocean segments -->
<div class="footer-stripe" aria-hidden="true">
  <span class="fs-coral"></span>
  <span class="fs-ocean"></span>
  <span class="fs-coral"></span>
  <span class="fs-ocean"></span>
  <span class="fs-coral"></span>
  <span class="fs-ocean"></span>
</div>

<footer id="footer">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="footer-logo">GHAF</span>
        <p class="footer-tagline">Get High And Fly</p>
      </div>
      <div class="footer-contact">
        <h3>{t('footer.contact')}</h3>
        <ul>
          <li>
            <a href={`mailto:${t('footer.email')}`}>{t('footer.email')}</a>
          </li>
          <li>
            <a href="#" rel="noopener" target="_blank">{t('footer.telegram')}</a>
          </li>
          <li>
            <a href="#" rel="noopener" target="_blank">{t('footer.instagram')}</a>
          </li>
        </ul>
      </div>
      <div class="footer-lang">
        <span class="footer-lang-label">{t('footer.lang')}</span>
        <LanguageSwitcher current={lang} />
      </div>
    </div>
    <div class="footer-bottom">
      <p class="footer-rights">{t('footer.rights')}</p>
      <nav class="footer-legal">
        <a href="#">{t('footer.privacy')}</a>
        <a href="#">{t('footer.rules')}</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  /* Poster-border stripe */
  .footer-stripe {
    display: flex;
    height: 8px;
  }

  .footer-stripe span {
    flex: 1;
  }

  .fs-coral {
    background: var(--color-accent);
  }

  .fs-ocean {
    background: var(--color-ocean);
  }

  /* Footer */
  #footer {
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
    padding: var(--space-xl) var(--space-l) var(--space-l);
  }

  .footer-container {
    max-width: var(--container-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (max-width: 640px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }

  .footer-logo {
    display: block;
    font-family: var(--font-display);
    font-size: 3rem;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    line-height: 1;
  }

  .footer-tagline {
    font-family: var(--font-accent);
    font-size: var(--text-small);
    color: var(--color-text-on-dark);
    opacity: 0.45;
    margin-top: var(--space-xs);
    font-style: italic;
  }

  .footer-contact h3 {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-on-dark);
    opacity: 0.5;
    margin-bottom: var(--space-s);
  }

  .footer-contact ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .footer-contact a {
    font-family: var(--font-body);
    color: var(--color-text-on-dark);
    text-decoration: none;
    opacity: 0.7;
    font-size: var(--text-body);
    transition: opacity var(--transition), color var(--transition);
  }

  .footer-contact a:hover {
    opacity: 1;
    color: var(--color-accent);
  }

  .footer-lang {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .footer-lang-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-on-dark);
    opacity: 0.5;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-m);
    padding-top: var(--space-l);
    border-top: 1px solid rgba(245,233,204,0.1);
  }

  .footer-rights {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-text-on-dark);
    opacity: 0.4;
  }

  .footer-legal {
    display: flex;
    gap: var(--space-m);
  }

  .footer-legal a {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-text-on-dark);
    opacity: 0.4;
    text-decoration: none;
    transition: opacity var(--transition);
  }

  .footer-legal a:hover {
    opacity: 0.8;
  }
</style>
