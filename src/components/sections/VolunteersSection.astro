---
import type { Lang } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const ROLES = ['judges', 'photo', 'media'] as const;
---
<div class="stripe-coral" aria-hidden="true"></div>
<section id="volunteers">
  <div class="volunteers-container reveal">
    <header>
      <h2>{t('volunteers.heading')}</h2>
      <p class="volunteers-intro">{t('volunteers.body')}</p>
    </header>
    <div class="roles-grid">
      {ROLES.map((role, idx) => (
        <article class="role-card">
          <span class="role-num">{String(idx + 1).padStart(2, '0')}</span>
          <h3>{t(`volunteers.roles.${role}.title`)}</h3>
          <p>{t(`volunteers.roles.${role}.desc`)}</p>
        </article>
      ))}
    </div>
    <div class="benefits-block">
      <p>{t('volunteers.benefits')}</p>
    </div>
    <a href="#registration" class="btn btn-primary">{t('volunteers.cta')}</a>
  </div>
</section>

<style>
  #volunteers {
    background: var(--color-bg);
    padding: var(--section-padding);
  }

  .volunteers-container {
    max-width: var(--container-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  header {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    color: var(--color-text);
    text-transform: uppercase;
  }

  .volunteers-intro {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-text-muted);
    max-width: 640px;
    line-height: var(--line-height-base);
  }

  .roles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-m);
  }

  @media (max-width: 768px) {
    .roles-grid {
      grid-template-columns: 1fr;
    }
  }

  .role-card {
    border: 1px solid rgba(26, 82, 118, 0.25);
    border-radius: var(--radius);
    padding: var(--space-l);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    background: var(--color-bg-alt);
    box-shadow: var(--shadow-card);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .role-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .role-card:hover {
      transform: none;
    }
  }

  .role-num {
    font-family: var(--font-mono);
    font-size: 2rem;
    color: var(--color-accent);
    opacity: 0.7;
    line-height: 1;
  }

  .role-card h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    color: var(--color-text);
    text-transform: uppercase;
  }

  .role-card p {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-text-muted);
    line-height: var(--line-height-base);
  }

  .benefits-block {
    background: var(--color-ocean);
    color: var(--color-text-on-dark);
    padding: var(--space-m) var(--space-l);
    border-radius: var(--radius);
  }

  .benefits-block p {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--line-height-base);
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    text-decoration: none;
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.06em;
    width: fit-content;
    transition: background var(--transition), border-color var(--transition);
  }

  .btn-primary {
    background: var(--color-accent);
    color: #fff;
    border: 2px solid var(--color-accent);
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }
</style>
