---
import { getCollection } from 'astro:content';
import type { Lang } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const seasons = (await getCollection('seasons')).sort((a, b) => b.data.year - a.data.year);
---
<div class="stripe-coral" aria-hidden="true"></div>
<section id="archive">
  <div class="archive-container reveal">
    <header>
      <h2>{t('archive.heading')}</h2>
    </header>
    {seasons.length > 0 ? (
      <>
        <div class="archive-tabs" role="tablist">
          {seasons.map((s, i) => (
            <button
              role="tab"
              class="archive-tab"
              data-year={String(s.data.year)}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`season-${s.data.year}`}
            >{s.data.year}</button>
          ))}
        </div>
        {seasons.map((s, i) => (
          <div
            id={`season-${s.data.year}`}
            role="tabpanel"
            class="season-panel"
            hidden={i !== 0}
          >
            {(s.data.status === 'upcoming' || s.data.status === 'registration-open') && (
              <div class="season-upcoming">
                <p>
                  {s.data.status === 'upcoming'
                    ? t('archive.upcoming.status')
                    : t('archive.open.cta')}
                </p>
                <a href="#registration" class="btn btn-primary">{t('archive.upcoming.cta')}</a>
              </div>
            )}
            {s.data.status === 'live' && (
              <p class="season-live">{t('archive.live.status')}</p>
            )}
            {s.data.status === 'past' && (
              <div class="season-past">
                {s.data.winners.length > 0 && (
                  <div class="winners-block">
                    <h3>{t('archive.past.winners')}</h3>
                    <ul>
                      {s.data.winners.map(w => (
                        <li>
                          <span class="winner-category">{w.category}</span>
                          <span class="winner-name">{w.name}</span>
                          <span class="winner-height">{w.height}<span class="winner-unit">m</span></span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                <p class="participants-count">
                  <span class="participants-num">{s.data.participantsCount}</span>
                  {t('archive.past.participants')}
                </p>
                {s.data.gallery.photos.length === 0 && (
                  <p class="nophoto">{t('archive.past.nophoto')}</p>
                )}
                {s.data.aftermovie && (
                  <a href={s.data.aftermovie} target="_blank" rel="noopener" class="aftermovie-link">
                    {t('archive.past.aftermovie')}
                  </a>
                )}
              </div>
            )}
          </div>
        ))}
      </>
    ) : (
      <p class="no-seasons">—</p>
    )}
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.archive-tab');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => { t.setAttribute('aria-selected', 'false'); });
      tab.setAttribute('aria-selected', 'true');
      document.querySelectorAll<HTMLElement>('.season-panel').forEach(p => { p.hidden = true; });
      const panel = document.getElementById(`season-${tab.dataset.year}`);
      if (panel) panel.hidden = false;
    });
  });
</script>

<style>
  #archive {
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
    padding: var(--section-padding);
  }

  .archive-container {
    max-width: var(--container-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  header h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    color: var(--color-text-on-dark);
    text-transform: uppercase;
  }

  .archive-tabs {
    display: flex;
    gap: var(--space-s);
    flex-wrap: wrap;
  }

  .archive-tab {
    padding: 0.5rem 1.25rem;
    border: 2px solid var(--color-accent);
    background: transparent;
    color: var(--color-text-on-dark);
    cursor: pointer;
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 1rem;
    transition: background var(--transition), color var(--transition);
  }

  .archive-tab:hover {
    background: rgba(232, 82, 42, 0.15);
  }

  .archive-tab[aria-selected="true"] {
    background: var(--color-accent);
    color: #fff;
    border-color: var(--color-accent);
    font-weight: 700;
  }

  .season-panel {
    min-height: 4rem;
  }

  .season-upcoming {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    align-items: flex-start;
  }

  .season-upcoming p {
    font-family: var(--font-body);
    color: var(--color-text-on-dark);
    opacity: 0.8;
  }

  .season-live {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    color: var(--color-accent);
    text-transform: uppercase;
  }

  .season-past {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .winners-block h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    color: var(--color-text-on-dark);
    text-transform: uppercase;
    margin-bottom: var(--space-s);
  }

  .winners-block ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .winners-block li {
    display: flex;
    align-items: baseline;
    gap: var(--space-m);
    font-family: var(--font-body);
    padding: var(--space-s) 0;
    border-bottom: 1px solid rgba(245,233,204,0.1);
  }

  .winner-category {
    font-size: var(--text-small);
    color: var(--color-text-on-dark);
    opacity: 0.6;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    min-width: 120px;
    flex-shrink: 0;
  }

  .winner-name {
    flex: 1;
    color: var(--color-text-on-dark);
    font-size: var(--text-body);
  }

  .winner-height {
    font-family: var(--font-mono);
    font-size: var(--text-h3);
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .winner-unit {
    font-family: var(--font-body);
    font-size: var(--text-small);
    opacity: 0.6;
    margin-left: 2px;
  }

  .participants-count {
    font-family: var(--font-body);
    color: var(--color-text-on-dark);
    opacity: 0.7;
    font-size: var(--text-small);
  }

  .participants-num {
    font-family: var(--font-mono);
    font-size: var(--text-h3);
    color: var(--color-text-on-dark);
    opacity: 1;
    margin-right: var(--space-s);
    vertical-align: baseline;
  }

  .nophoto {
    font-family: var(--font-body);
    color: var(--color-text-on-dark);
    opacity: 0.5;
    font-style: italic;
  }

  .aftermovie-link {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition);
  }

  .aftermovie-link:hover {
    color: var(--color-text-on-dark);
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    text-decoration: none;
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.06em;
    transition: background var(--transition), border-color var(--transition);
  }

  .btn-primary {
    background: var(--color-accent);
    color: #fff;
    border: 2px solid var(--color-accent);
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  .no-seasons {
    font-family: var(--font-body);
    color: var(--color-text-on-dark);
    opacity: 0.4;
  }
</style>
