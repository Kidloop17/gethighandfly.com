---
import type { Lang } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
  startDate?: string;
}

const { lang, startDate } = Astro.props;
const t = useTranslations(lang);

// Только передаём дату в client script если она не TODO
const validDate = startDate && !startDate.includes('TODO') ? startDate : undefined;
---
<section id="hero">
  <!-- Decorative background layer -->
  <div class="hero-bg" aria-hidden="true">
    <!-- Sunray SVG decoration -->
    <svg class="hero-sunrays" viewBox="0 0 800 800" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      {Array.from({ length: 18 }).map((_, i) => (
        <line
          x1="400" y1="400"
          x2={400 + 600 * Math.cos((i * 20 * Math.PI) / 180)}
          y2={400 + 600 * Math.sin((i * 20 * Math.PI) / 180)}
          stroke="#F5E9CC"
          stroke-width="1.5"
          stroke-opacity="0.06"
        />
      ))}
      <circle cx="400" cy="400" r="180" fill="#F5E9CC" fill-opacity="0.04" />
      <circle cx="400" cy="400" r="100" fill="#F5E9CC" fill-opacity="0.06" />
    </svg>

    <!-- Kite surfer silhouette SVG -->
    <svg class="hero-kiter" viewBox="0 0 220 340" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- Kite (diamond shape, top) -->
      <polygon points="110,10 150,70 110,130 70,70" fill="#F5E9CC" />
      <!-- Kite lines -->
      <line x1="110" y1="130" x2="100" y2="220" stroke="#F5E9CC" stroke-width="1.5" />
      <line x1="110" y1="130" x2="120" y2="220" stroke="#F5E9CC" stroke-width="1.5" />
      <!-- Body -->
      <ellipse cx="110" cy="215" rx="12" ry="16" fill="#F5E9CC" />
      <!-- Head -->
      <circle cx="110" cy="196" r="9" fill="#F5E9CC" />
      <!-- Bar / arms spread -->
      <line x1="75" y1="218" x2="145" y2="218" stroke="#F5E9CC" stroke-width="3" stroke-linecap="round" />
      <!-- Legs slightly bent -->
      <line x1="104" y1="230" x2="92" y2="270" stroke="#F5E9CC" stroke-width="4" stroke-linecap="round" />
      <line x1="116" y1="230" x2="128" y2="270" stroke="#F5E9CC" stroke-width="4" stroke-linecap="round" />
      <!-- Board -->
      <rect x="78" y="266" width="64" height="10" rx="5" fill="#F5E9CC" />
      <!-- Wind/spray lines at board level -->
      <line x1="60" y1="275" x2="30" y2="285" stroke="#F5E9CC" stroke-width="1" stroke-opacity="0.5" />
      <line x1="55" y1="268" x2="25" y2="272" stroke="#F5E9CC" stroke-width="1" stroke-opacity="0.3" />
      <line x1="165" y1="275" x2="195" y2="285" stroke="#F5E9CC" stroke-width="1" stroke-opacity="0.5" />
    </svg>
  </div>

  <!-- Hero content -->
  <div class="hero-content reveal">
    <p class="hero-label">{t('hero.dates')}</p>
    <h1>Get High<br />And Fly</h1>
    <p class="hero-spot">{t('hero.spot')}</p>

    {validDate && (
      <div class="countdown" data-target={validDate}>
        <span class="countdown-label">{t('hero.countdown.label')}</span>
        <div class="countdown-display">
          <div class="cd-unit">
            <span class="cd-days cd-num">--</span>
            <span class="cd-unit-label">{t('hero.countdown.days')}</span>
          </div>
          <span class="cd-sep">:</span>
          <div class="cd-unit">
            <span class="cd-hours cd-num">--</span>
            <span class="cd-unit-label">{t('hero.countdown.hours')}</span>
          </div>
          <span class="cd-sep">:</span>
          <div class="cd-unit">
            <span class="cd-min cd-num">--</span>
            <span class="cd-unit-label">{t('hero.countdown.minutes')}</span>
          </div>
          <span class="cd-sep">:</span>
          <div class="cd-unit">
            <span class="cd-sec cd-num">--</span>
            <span class="cd-unit-label">{t('hero.countdown.seconds')}</span>
          </div>
        </div>
      </div>
    )}

    <div class="hero-actions">
      <a href="#registration" class="btn btn-primary">{t('hero.cta.register')}</a>
      <a href="#archive" class="btn btn-secondary">{t('hero.cta.archive')}</a>
    </div>
  </div>
</section>

<script>
  // Countdown timer
  const el = document.querySelector('.countdown[data-target]') as HTMLElement | null;
  if (el) {
    const raw = el.dataset.target ?? '';
    if (raw && !raw.includes('TODO')) {
      const target = new Date(raw).getTime();
      function tick() {
        const diff = target - Date.now();
        if (diff <= 0) {
          const display = el!.querySelector('.countdown-display');
          const label = el!.querySelector('.countdown-label');
          if (display && label) display.textContent = label.textContent ?? '';
          return;
        }
        const d = Math.floor(diff / 86400000);
        const h = Math.floor((diff % 86400000) / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        const s = Math.floor((diff % 60000) / 1000);
        const days = el!.querySelector('.cd-days') as HTMLElement | null;
        const hours = el!.querySelector('.cd-hours') as HTMLElement | null;
        const min = el!.querySelector('.cd-min') as HTMLElement | null;
        const sec = el!.querySelector('.cd-sec') as HTMLElement | null;
        if (days) days.textContent = String(d).padStart(2, '0');
        if (hours) hours.textContent = String(h).padStart(2, '0');
        if (min) min.textContent = String(m).padStart(2, '0');
        if (sec) sec.textContent = String(s).padStart(2, '0');
      }
      tick();
      setInterval(tick, 1000);
    }
  }

  // Parallax effect for hero-bg
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const heroBg = document.querySelector('.hero-bg') as HTMLElement | null;
    if (heroBg) {
      function onScroll() {
        const scrollY = window.scrollY;
        heroBg!.style.transform = `translateY(${scrollY * 0.4}px)`;
      }
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }
</script>

<style>
  #hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-2xl) var(--space-l) var(--space-xl);
    background: var(--color-bg-dark);
    overflow: hidden;
  }

  /* Background layer: sunrays + kiter silhouette */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    will-change: transform;
  }

  .hero-sunrays {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 120%;
    height: 120%;
    transform: translate(-50%, -50%);
  }

  .hero-kiter {
    position: absolute;
    right: 5%;
    top: 50%;
    transform: translateY(-50%);
    width: min(320px, 45vw);
    height: auto;
    opacity: 0.15;
  }

  /* Content */
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: var(--container-width);
    width: 100%;
    margin: 0 auto;
  }

  .hero-label {
    font-family: var(--font-accent);
    font-size: var(--text-h3);
    color: var(--color-accent);
    margin-bottom: var(--space-m);
    font-style: italic;
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    color: var(--color-text-on-dark);
    line-height: 0.95;
    margin-bottom: var(--space-m);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .hero-spot {
    font-family: var(--font-accent);
    font-size: var(--text-h3);
    color: var(--color-ocean);
    margin-bottom: var(--space-l);
    color: #6EB5D8;
  }

  /* Countdown */
  .countdown {
    margin: var(--space-l) 0;
  }

  .countdown-label {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-text-on-dark);
    opacity: 0.6;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: var(--space-s);
  }

  .countdown-display {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);
  }

  .cd-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .cd-num {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--color-text-on-dark);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .cd-unit-label {
    font-family: var(--font-body);
    font-size: 0.65rem;
    color: var(--color-text-on-dark);
    opacity: 0.5;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .cd-sep {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--color-accent);
    line-height: 1;
    align-self: flex-start;
    margin-top: 2px;
  }

  /* CTA buttons */
  .hero-actions {
    margin-top: var(--space-l);
    display: flex;
    gap: var(--space-m);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    text-decoration: none;
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.06em;
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }

  .btn-primary {
    background: var(--color-accent);
    color: #fff;
    border: 2px solid var(--color-accent);
  }
  .btn-primary:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  .btn-secondary {
    border: 2px solid var(--color-text-on-dark);
    color: var(--color-text-on-dark);
    background: transparent;
  }
  .btn-secondary:hover {
    background: rgba(245,233,204,0.1);
  }

  @media (max-width: 600px) {
    #hero {
      padding: calc(var(--space-2xl) + 2rem) var(--space-m) var(--space-xl);
    }
    .hero-kiter {
      opacity: 0.08;
    }
    .countdown-display {
      gap: var(--space-xs);
    }
    .hero-actions {
      flex-direction: column;
    }
    .btn {
      text-align: center;
    }
  }
</style>
