---
import type { Lang } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
  startDate?: string;
}

const { lang, startDate } = Astro.props;
const t = useTranslations(lang);

// Только передаём дату в client script если она не TODO
const validDate = startDate && !startDate.includes('TODO') ? startDate : undefined;
---
<section id="hero">
  <!-- Decorative background layer -->
  <div class="hero-bg" aria-hidden="true">
    <!-- Speed lines (kinetic wind energy) -->
    <svg class="hero-streaks" viewBox="0 0 1200 800" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      {[60, 140, 210, 290, 360, 430, 490, 540, 600, 660, 720, 780].map((y, i) => (
        <line
          x1="0" y1={y}
          x2={180 + (i % 4) * 140} y2={y}
          stroke="#0099FF"
          stroke-width={i % 3 === 0 ? "1.5" : "0.8"}
          stroke-opacity={i % 2 === 0 ? "0.07" : "0.04"}
        />
      ))}
      <line x1="0" y1="320" x2="480" y2="320" stroke="#FF2020" stroke-width="1" stroke-opacity="0.06" />
      <line x1="0" y1="440" x2="360" y2="440" stroke="#FF2020" stroke-width="0.8" stroke-opacity="0.04" />
    </svg>

    <!-- Kite surfer silhouette — dynamic, neon -->
    <svg class="hero-kiter" viewBox="0 0 220 340" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- Kite (diamond shape, top) -->
      <polygon points="110,10 155,75 110,135 65,75" fill="#0099FF" />
      <!-- Kite inner highlight -->
      <polygon points="110,30 140,75 110,115 80,75" fill="#00D2FF" fill-opacity="0.4" />
      <!-- Kite lines -->
      <line x1="110" y1="135" x2="98" y2="222" stroke="#E8F4FF" stroke-width="1.5" stroke-opacity="0.7" />
      <line x1="110" y1="135" x2="122" y2="222" stroke="#E8F4FF" stroke-width="1.5" stroke-opacity="0.7" />
      <!-- Body -->
      <ellipse cx="110" cy="217" rx="13" ry="17" fill="#E8F4FF" />
      <!-- Head -->
      <circle cx="110" cy="197" r="10" fill="#E8F4FF" />
      <!-- Bar / arms spread -->
      <line x1="72" y1="220" x2="148" y2="220" stroke="#E8F4FF" stroke-width="3.5" stroke-linecap="round" />
      <!-- Legs bent — big air pose -->
      <line x1="103" y1="233" x2="88" y2="274" stroke="#E8F4FF" stroke-width="4.5" stroke-linecap="round" />
      <line x1="117" y1="233" x2="132" y2="274" stroke="#E8F4FF" stroke-width="4.5" stroke-linecap="round" />
      <!-- Board -->
      <rect x="74" y="270" width="70" height="11" rx="5" fill="#0099FF" />
      <!-- Spray lines -->
      <line x1="58" y1="278" x2="22" y2="290" stroke="#0099FF" stroke-width="1.2" stroke-opacity="0.6" />
      <line x1="52" y1="270" x2="18" y2="274" stroke="#0099FF" stroke-width="0.9" stroke-opacity="0.4" />
      <line x1="168" y1="278" x2="204" y2="290" stroke="#0099FF" stroke-width="1.2" stroke-opacity="0.6" />
    </svg>

    <!-- Bottom gradient fade to next section -->
    <div class="hero-fade"></div>
  </div>

  <!-- Hero content -->
  <div class="hero-content reveal">
    <p class="hero-label">{t('hero.dates')}</p>
    <h1>Get High<br />And Fly</h1>
    <p class="hero-spot">{t('hero.spot')}</p>

    {validDate && (
      <div class="countdown" data-target={validDate}>
        <span class="countdown-label">{t('hero.countdown.label')}</span>
        <div class="countdown-display">
          <div class="cd-unit">
            <span class="cd-days cd-num">--</span>
            <span class="cd-unit-label">{t('hero.countdown.days')}</span>
          </div>
          <span class="cd-sep">:</span>
          <div class="cd-unit">
            <span class="cd-hours cd-num">--</span>
            <span class="cd-unit-label">{t('hero.countdown.hours')}</span>
          </div>
          <span class="cd-sep">:</span>
          <div class="cd-unit">
            <span class="cd-min cd-num">--</span>
            <span class="cd-unit-label">{t('hero.countdown.minutes')}</span>
          </div>
          <span class="cd-sep">:</span>
          <div class="cd-unit">
            <span class="cd-sec cd-num">--</span>
            <span class="cd-unit-label">{t('hero.countdown.seconds')}</span>
          </div>
        </div>
      </div>
    )}

    <div class="hero-actions">
      <a href="#registration" class="btn btn-primary">{t('hero.cta.register')}</a>
      <a href="#archive" class="btn btn-secondary">{t('hero.cta.archive')}</a>
    </div>
  </div>
</section>

<script>
  // Countdown timer
  const el = document.querySelector('.countdown[data-target]') as HTMLElement | null;
  if (el) {
    const raw = el.dataset.target ?? '';
    if (raw && !raw.includes('TODO')) {
      const target = new Date(raw).getTime();
      function tick() {
        const diff = target - Date.now();
        if (diff <= 0) {
          const display = el!.querySelector('.countdown-display');
          const label = el!.querySelector('.countdown-label');
          if (display && label) display.textContent = label.textContent ?? '';
          return;
        }
        const d = Math.floor(diff / 86400000);
        const h = Math.floor((diff % 86400000) / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        const s = Math.floor((diff % 60000) / 1000);
        const days = el!.querySelector('.cd-days') as HTMLElement | null;
        const hours = el!.querySelector('.cd-hours') as HTMLElement | null;
        const min = el!.querySelector('.cd-min') as HTMLElement | null;
        const sec = el!.querySelector('.cd-sec') as HTMLElement | null;
        if (days) days.textContent = String(d).padStart(2, '0');
        if (hours) hours.textContent = String(h).padStart(2, '0');
        if (min) min.textContent = String(m).padStart(2, '0');
        if (sec) sec.textContent = String(s).padStart(2, '0');
      }
      tick();
      setInterval(tick, 1000);
    }
  }

  // Parallax effect for hero-bg
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const heroBg = document.querySelector('.hero-bg') as HTMLElement | null;
    if (heroBg) {
      function onScroll() {
        const scrollY = window.scrollY;
        heroBg!.style.transform = `translateY(${scrollY * 0.4}px)`;
      }
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }
</script>

<style>
  #hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-2xl) var(--space-l) var(--space-xl);
    background: var(--color-bg-dark);
    overflow: hidden;
  }

  /* Background layer: speed streaks + kiter silhouette */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    will-change: transform;
  }

  .hero-streaks {
    position: absolute;
    top: 0;
    left: 0;
    width: 60%;
    height: 100%;
  }

  .hero-kiter {
    position: absolute;
    right: 4%;
    top: 50%;
    transform: translateY(-52%);
    width: min(340px, 46vw);
    height: auto;
    opacity: 0.45;
    filter: drop-shadow(0 0 24px rgba(0, 153, 255, 0.5));
  }

  .hero-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 120px;
    background: linear-gradient(to bottom, transparent, #050D1A);
    pointer-events: none;
  }

  /* Content */
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: var(--container-width);
    width: 100%;
    margin: 0 auto;
  }

  .hero-label {
    font-family: var(--font-accent);
    font-size: var(--text-h3);
    color: var(--color-ocean);
    margin-bottom: var(--space-m);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    color: var(--color-text-on-dark);
    line-height: 0.95;
    margin-bottom: var(--space-m);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .hero-spot {
    font-family: var(--font-accent);
    font-size: var(--text-h3);
    color: var(--color-text-muted);
    margin-bottom: var(--space-l);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Countdown */
  .countdown {
    margin: var(--space-l) 0;
  }

  .countdown-label {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-text-on-dark);
    opacity: 0.6;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: var(--space-s);
  }

  .countdown-display {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);
  }

  .cd-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .cd-num {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--color-text-on-dark);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .cd-unit-label {
    font-family: var(--font-body);
    font-size: 0.65rem;
    color: var(--color-text-on-dark);
    opacity: 0.5;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .cd-sep {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--color-accent);
    line-height: 1;
    align-self: flex-start;
    margin-top: 2px;
  }

  /* CTA buttons */
  .hero-actions {
    margin-top: var(--space-l);
    display: flex;
    gap: var(--space-m);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    text-decoration: none;
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.06em;
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }

  .btn-primary {
    background: var(--color-accent);
    color: #fff;
    border: 2px solid var(--color-accent);
  }
  .btn-primary:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  .btn-secondary {
    border: 2px solid var(--color-text-on-dark);
    color: var(--color-text-on-dark);
    background: transparent;
  }
  .btn-secondary:hover {
    background: rgba(245,233,204,0.1);
  }

  @media (max-width: 600px) {
    #hero {
      padding: calc(var(--space-2xl) + 2rem) var(--space-m) var(--space-xl);
    }
    .hero-kiter {
      opacity: 0.08;
    }
    .countdown-display {
      gap: var(--space-xs);
    }
    .hero-actions {
      flex-direction: column;
    }
    .btn {
      text-align: center;
    }
  }
</style>
