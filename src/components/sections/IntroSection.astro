---
import type { Lang } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---
<div class="stripe-coral" aria-hidden="true"></div>
<section id="intro">
  <div class="intro-container">
    <div class="intro-layout">
      <div class="intro-left">
        <header class="intro-header reveal">
          <h2>{t('intro.heading')}</h2>
        </header>
        <div class="intro-body reveal">
          <p>{t('intro.body1')}</p>
          <p>{t('intro.body2')}</p>
        </div>
        <div class="intro-stats">
          <article class="stat reveal">
            <span class="stat-value">{t('intro.stat.year.value')}</span>
            <span class="stat-label">{t('intro.stat.year.label')}</span>
          </article>
          <article class="stat reveal">
            <span class="stat-value">{t('intro.stat.participants.value')}</span>
            <span class="stat-label">{t('intro.stat.participants.label')}</span>
          </article>
          <article class="stat reveal">
            <span class="stat-value">{t('intro.stat.record.value')}</span>
            <span class="stat-label">{t('intro.stat.record.label')}</span>
          </article>
        </div>
      </div>
      <div class="intro-video reveal">
        <video controls preload="none" playsinline>
          <source src="/video/ghaf-highlight.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </div>
</section>

<style>
  #intro {
    background: var(--color-bg-alt);
    padding: var(--section-padding);
  }

  .intro-container {
    max-width: var(--container-width);
    margin: 0 auto;
  }

  .intro-layout {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (max-width: 768px) {
    .intro-layout {
      grid-template-columns: 1fr;
    }
    .intro-video {
      max-width: 260px;
    }
  }

  .intro-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .intro-header h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    color: var(--color-ocean);
    text-transform: uppercase;
  }

  .intro-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-text);
    line-height: var(--line-height-base);
  }

  .intro-stats {
    display: flex;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .stat-value {
    font-family: var(--font-mono);
    font-size: var(--text-h1);
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .intro-video video {
    width: 100%;
    border-radius: var(--radius);
    display: block;
    background: var(--color-bg-dark);
  }

  @media (max-width: 600px) {
    .intro-stats {
      gap: var(--space-l);
    }
  }
</style>
