---
import type { Lang } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const CATEGORIES = ['pro_men', 'pro_women', 'amateur', 'junior'] as const;
---
<div class="stripe-ocean" aria-hidden="true"></div>
<section id="disciplines">
  <div class="disciplines-container">
    <header class="reveal">
      <h2>{t('disciplines.heading')}</h2>
    </header>
    <div class="categories-grid reveal">
      {CATEGORIES.map((cat, idx) => (
        <article class="category-card">
          <span class="cat-num">{String(idx + 1).padStart(2, '0')}</span>
          <h3>{t(`disciplines.${cat}.title`)}</h3>
          <p>{t(`disciplines.${cat}.desc`)}</p>
          <footer class="card-footer">
            <span class="slots">{t('disciplines.slots')}</span>
            <span class="fee">{t('disciplines.fee')}</span>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  #disciplines {
    background: var(--color-bg);
    padding: var(--section-padding);
  }

  .disciplines-container {
    max-width: var(--container-width);
    margin: 0 auto;
  }

  header {
    margin-bottom: var(--space-l);
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    color: var(--color-text);
    text-transform: uppercase;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m);
  }

  @media (max-width: 640px) {
    .categories-grid {
      grid-template-columns: 1fr;
    }
  }

  .category-card {
    border: 1px solid rgba(0, 153, 255, 0.25);
    border-radius: var(--radius);
    padding: var(--space-l);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    background: var(--color-bg-alt);
    box-shadow: var(--shadow-card);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
    position: relative;
    overflow: hidden;
  }

  .category-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: rgba(0, 153, 255, 0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    .category-card:hover {
      transform: none;
    }
  }

  .cat-num {
    font-family: var(--font-mono);
    font-size: 2rem;
    color: var(--color-accent);
    opacity: 0.6;
    line-height: 1;
  }

  .category-card h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    color: var(--color-text);
    text-transform: uppercase;
  }

  .category-card p {
    font-family: var(--font-body);
    flex: 1;
    color: var(--color-text-muted);
    line-height: var(--line-height-base);
    font-size: var(--text-body);
  }

  .card-footer {
    margin-top: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-text-muted);
    border-top: 1px solid rgba(0, 153, 255, 0.15);
    padding-top: var(--space-s);
  }
</style>
