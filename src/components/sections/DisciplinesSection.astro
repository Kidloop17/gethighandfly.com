---
import type { Lang } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const CATEGORIES = ['pro_men', 'pro_women', 'amateur', 'junior'] as const;
---
<section id="disciplines">
  <div class="disciplines-container">
    <header>
      <h2>{t('disciplines.heading')}</h2>
    </header>
    <div class="categories-grid">
      {CATEGORIES.map(cat => (
        <article class="category-card">
          <h3>{t(`disciplines.${cat}.title`)}</h3>
          <p>{t(`disciplines.${cat}.desc`)}</p>
          <footer class="card-footer">
            <span class="slots">{t('disciplines.slots')}</span>
            <span class="fee">{t('disciplines.fee')}</span>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  #disciplines {
    padding: var(--space-xl) var(--space-l);
    background: color-mix(in srgb, var(--color-bg) 95%, var(--color-accent));
  }
  .disciplines-container {
    max-width: var(--container-max);
    margin: 0 auto;
  }
  header {
    margin-bottom: var(--space-l);
  }
  h2 {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
  }
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-m);
  }
  .category-card {
    border: 1px solid color-mix(in srgb, var(--color-text) 20%, transparent);
    border-radius: 8px;
    padding: var(--space-l);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  .category-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-accent);
  }
  .category-card p {
    flex: 1;
    opacity: 0.85;
    line-height: var(--line-height-base);
  }
  .card-footer {
    margin-top: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    font-size: 0.875rem;
    opacity: 0.6;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
    padding-top: var(--space-s);
  }
</style>
