---
import type { Lang } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
  status?: 'upcoming' | 'registration-open' | 'live' | 'past';
}

const { lang, status } = Astro.props;
const t = useTranslations(lang);

const isOpen = status === 'registration-open';
---
<div class="stripe-ocean" aria-hidden="true"></div>
<section id="registration">
  <div class="registration-container reveal">
    <header>
      <h2>{t('registration.heading')}</h2>
      <p class="registration-sub">{t('registration.subheading')}</p>
    </header>

    {isOpen ? (
      <form id="registration-form" class="registration-form" novalidate>
        <!-- Honeypot field — hidden from real users -->
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" />
        <!-- Timestamp for time-based anti-spam -->
        <input type="hidden" id="formOpenedAt" name="_formOpenedAt" />

        <div class="form-row">
          <div class="form-field">
            <label for="firstName">{t('registration.field.firstName')}</label>
            <input type="text" id="firstName" name="firstName" required autocomplete="given-name" maxlength="100" />
          </div>
          <div class="form-field">
            <label for="lastName">{t('registration.field.lastName')}</label>
            <input type="text" id="lastName" name="lastName" required autocomplete="family-name" maxlength="100" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-field">
            <label for="email">{t('registration.field.email')}</label>
            <input type="email" id="email" name="email" required autocomplete="email" maxlength="255" />
          </div>
          <div class="form-field">
            <label for="phone">{t('registration.field.phone')}</label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" maxlength="30" />
          </div>
        </div>
        <div class="form-field">
          <label for="country">{t('registration.field.country')}</label>
          <input type="text" id="country" name="country" autocomplete="country-name" maxlength="100" />
        </div>
        <div class="form-field">
          <label for="category">{t('registration.field.category')}</label>
          <select id="category" name="category" required>
            <option value="">—</option>
            <option value="pro-men">Pro Men</option>
            <option value="pro-women">Pro Women</option>
            <option value="amateur">Amateur</option>
            <option value="junior">Junior (U18)</option>
          </select>
          <div class="slot-counts">
            <span id="slot-info-pro-men" class="slot-info" data-cat="pro-men"></span>
            <span id="slot-info-pro-women" class="slot-info" data-cat="pro-women"></span>
            <span id="slot-info-amateur" class="slot-info" data-cat="amateur"></span>
            <span id="slot-info-junior" class="slot-info" data-cat="junior"></span>
          </div>
        </div>
        <div class="form-row">
          <div class="form-field">
            <label for="experience">{t('registration.field.experience')}</label>
            <input type="number" id="experience" name="experience" min="0" max="50" />
          </div>
          <div class="form-field">
            <label for="kiteSize">{t('registration.field.kiteSize')}</label>
            <input type="number" id="kiteSize" name="kiteSize" min="3" max="25" step="0.5" />
          </div>
        </div>
        <div class="form-field form-field--checkbox">
          <input type="checkbox" id="consent" name="consent" required />
          <label for="consent">{t('registration.field.consent')}</label>
        </div>
        <button
          type="submit"
          class="btn btn-primary"
          data-label={t('registration.submit')}
          data-submitting={t('registration.submitting')}
          data-msg-success={t('registration.success')}
          data-msg-waitlist={t('registration.waitlistSuccess')}
          data-msg-duplicate={t('registration.duplicateEmail')}
          data-msg-error={t('registration.error')}
        >
          {t('registration.submit')}
        </button>
        <div id="form-message" class="form-message" role="alert" aria-live="polite"></div>
        <p class="registration-notice">{t('registration.notice')}</p>
      </form>
    ) : (
      <div class="registration-closed">
        <p class="closed-text">{t('registration.closed')}</p>
      </div>
    )}
  </div>
</section>

<script>
  // Set form opened timestamp for anti-spam time check
  const formOpenedAt = document.getElementById('formOpenedAt');
  if (formOpenedAt) {
    formOpenedAt.setAttribute('value', Date.now().toString());
  }

  // Show slot info for a specific category
  function updateSlotDisplay(catId: string, data: { available: number; waitlist: boolean }) {
    const el = document.getElementById(`slot-info-${catId}`);
    if (!el) return;
    if (data.available > 0) {
      el.textContent = `${data.available} spots available`;
      el.className = 'slot-info slot-available';
    } else {
      el.textContent = 'Full — waitlist';
      el.className = 'slot-info slot-waitlist';
    }
  }

  // Load and display slot counts from API
  async function loadSlots() {
    try {
      const r = await fetch('/api/slots');
      if (!r.ok) return;
      const { slots } = await r.json();
      for (const [cat, data] of Object.entries(slots) as [string, { available: number; waitlist: boolean }][]) {
        updateSlotDisplay(cat, data);
      }
    } catch {
      // Slot counts are informational; silently ignore if API is unreachable
    }
  }
  loadSlots();

  // Show slot count for currently selected category below the select
  const categorySelect = document.getElementById('category') as HTMLSelectElement | null;
  const slotInfoEls = document.querySelectorAll<HTMLElement>('.slot-info[data-cat]');

  function syncSlotVisibility() {
    const selected = categorySelect?.value ?? '';
    slotInfoEls.forEach((el) => {
      const cat = el.getAttribute('data-cat');
      el.style.display = cat === selected ? 'inline' : 'none';
    });
  }

  categorySelect?.addEventListener('change', syncSlotVisibility);
  // Hide all slot infos initially (will show after selection)
  syncSlotVisibility();

  // Form submit handler
  const form = document.getElementById('registration-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
    const msg = document.getElementById('form-message');
    if (!btn || !msg) return;

    // Store original label for error recovery
    const originalLabel = btn.getAttribute('data-label') ?? btn.textContent ?? '';

    btn.disabled = true;
    btn.textContent = btn.getAttribute('data-submitting') ?? '...';
    msg.textContent = '';
    msg.className = 'form-message';

    const rawData = Object.fromEntries(new FormData(form)) as Record<string, string>;

    // Build typed payload
    const payload: Record<string, unknown> = {
      firstName: rawData.firstName,
      lastName: rawData.lastName,
      email: rawData.email,
      phone: rawData.phone || undefined,
      country: rawData.country || undefined,
      category: rawData.category,
      lang: document.documentElement.lang || 'en',
      _formOpenedAt: rawData._formOpenedAt,
      website: rawData.website ?? '',
    };
    if (rawData.experience) payload.experience = parseInt(rawData.experience, 10);
    if (rawData.kiteSize) payload.kiteSize = parseFloat(rawData.kiteSize);

    try {
      const r = await fetch('/api/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await r.json() as { status?: string; error?: string };

      if (r.ok) {
        form.style.display = 'none';
        msg.className = 'form-message form-success';
        msg.textContent =
          result.status === 'waitlist'
            ? btn.getAttribute('data-msg-waitlist') ?? ''
            : btn.getAttribute('data-msg-success') ?? '';
      } else if (result.error === 'email_exists') {
        msg.className = 'form-message form-error';
        msg.textContent = btn.getAttribute('data-msg-duplicate') ?? '';
        btn.disabled = false;
        btn.textContent = originalLabel;
      } else {
        throw new Error(result.error ?? 'unknown');
      }
    } catch {
      msg.className = 'form-message form-error';
      msg.textContent = btn.getAttribute('data-msg-error') ?? '';
      btn.disabled = false;
      btn.textContent = originalLabel;
    }
  });
</script>

<style>
  #registration {
    background: var(--color-bg);
    padding: var(--section-padding);
  }

  .registration-container {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  header {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    color: var(--color-text);
    text-transform: uppercase;
  }

  .registration-sub {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-text-muted);
    line-height: var(--line-height-base);
  }

  .registration-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  /* Honeypot — hidden from real users */
  .hp {
    display: none !important;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
  }

  @media (max-width: 540px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .form-field label {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .form-field input,
  .form-field select {
    background: var(--color-bg-alt);
    border: 2px solid var(--color-ocean);
    border-radius: var(--radius);
    padding: 0.625rem 0.75rem;
    color: var(--color-text);
    font-size: 1rem;
    font-family: var(--font-body);
    width: 100%;
    transition: border-color var(--transition);
  }

  .form-field input:focus,
  .form-field select:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .form-field--checkbox {
    flex-direction: row;
    align-items: flex-start;
    gap: var(--space-s);
  }

  .form-field--checkbox input[type="checkbox"] {
    width: auto;
    flex-shrink: 0;
    margin-top: 3px;
    accent-color: var(--color-accent);
  }

  .form-field--checkbox label {
    font-size: var(--text-small);
    cursor: pointer;
  }

  /* Slot availability indicators */
  .slot-counts {
    margin-top: var(--space-xs);
    min-height: 1.25rem;
  }

  .slot-info {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .slot-available {
    color: var(--color-ocean);
  }

  .slot-waitlist {
    color: var(--color-accent);
  }

  /* Submit button */
  .btn {
    display: block;
    width: 100%;
    padding: 1rem 2rem;
    text-decoration: none;
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.06em;
    border: none;
    cursor: pointer;
    text-align: center;
    transition: background var(--transition);
  }

  .btn-primary {
    background: var(--color-accent);
    color: #fff;
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--color-accent-hover);
  }

  .btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Form feedback messages */
  .form-message {
    font-family: var(--font-body);
    font-size: var(--text-body);
    border-radius: var(--radius);
    padding: 0;
    min-height: 0;
    transition: padding var(--transition);
  }

  .form-success {
    color: var(--color-ocean);
    background: rgba(28, 43, 58, 0.06);
    padding: var(--space-m);
    border-left: 3px solid var(--color-ocean);
  }

  .form-error {
    color: var(--color-accent);
    background: rgba(224, 80, 54, 0.06);
    padding: var(--space-m);
    border-left: 3px solid var(--color-accent);
  }

  .registration-notice {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-style: italic;
    text-align: center;
  }

  .registration-closed {
    padding: var(--space-xl);
    border: 2px dashed rgba(28, 43, 58, 0.2);
    border-radius: var(--radius);
    text-align: center;
  }

  .closed-text {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    color: var(--color-text-muted);
    text-transform: uppercase;
    line-height: 1.2;
  }
</style>
