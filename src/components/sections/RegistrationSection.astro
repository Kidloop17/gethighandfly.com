---
import type { Lang } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
  status?: 'upcoming' | 'registration-open' | 'live' | 'past';
}

const { lang, status } = Astro.props;
const t = useTranslations(lang);

const isOpen = status === 'registration-open';
---
<div class="stripe-ocean" aria-hidden="true"></div>
<section id="registration">
  <div class="registration-container reveal">
    <header>
      <h2>{t('registration.heading')}</h2>
      <p class="registration-sub">{t('registration.subheading')}</p>
    </header>

    {isOpen ? (
      <form action="#" method="GET" class="registration-form">
        <div class="form-row">
          <div class="form-field">
            <label for="firstName">{t('registration.field.firstName')}</label>
            <input type="text" id="firstName" name="firstName" required autocomplete="given-name" />
          </div>
          <div class="form-field">
            <label for="lastName">{t('registration.field.lastName')}</label>
            <input type="text" id="lastName" name="lastName" required autocomplete="family-name" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-field">
            <label for="email">{t('registration.field.email')}</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>
          <div class="form-field">
            <label for="phone">{t('registration.field.phone')}</label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" />
          </div>
        </div>
        <div class="form-field">
          <label for="country">{t('registration.field.country')}</label>
          <input type="text" id="country" name="country" autocomplete="country-name" />
        </div>
        <div class="form-field">
          <label for="category">{t('registration.field.category')}</label>
          <select id="category" name="category" required>
            <option value="">—</option>
            <option value="pro-men">Pro Men</option>
            <option value="pro-women">Pro Women</option>
            <option value="amateur">Amateur</option>
            <option value="junior">Junior (U18)</option>
          </select>
        </div>
        <div class="form-row">
          <div class="form-field">
            <label for="experience">{t('registration.field.experience')}</label>
            <input type="number" id="experience" name="experience" min="0" max="50" />
          </div>
          <div class="form-field">
            <label for="kiteSize">{t('registration.field.kiteSize')}</label>
            <input type="number" id="kiteSize" name="kiteSize" min="3" max="25" step="0.5" />
          </div>
        </div>
        <div class="form-field form-field--checkbox">
          <input type="checkbox" id="consent" name="consent" required />
          <label for="consent">{t('registration.field.consent')}</label>
        </div>
        <button
          type="submit"
          class="btn btn-primary"
          disabled
          title="Coming in Phase 3"
        >
          {t('registration.submit')}
        </button>
        <p class="registration-notice">{t('registration.notice')}</p>
      </form>
    ) : (
      <div class="registration-closed">
        <p class="closed-text">{t('registration.closed')}</p>
      </div>
    )}
  </div>
</section>

<style>
  #registration {
    background: var(--color-bg);
    padding: var(--section-padding);
  }

  .registration-container {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  header {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    color: var(--color-text);
    text-transform: uppercase;
  }

  .registration-sub {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-text-muted);
    line-height: var(--line-height-base);
  }

  .registration-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
  }

  @media (max-width: 540px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .form-field label {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .form-field input,
  .form-field select {
    background: var(--color-bg-alt);
    border: 2px solid var(--color-ocean);
    border-radius: var(--radius);
    padding: 0.625rem 0.75rem;
    color: var(--color-text);
    font-size: 1rem;
    font-family: var(--font-body);
    width: 100%;
    transition: border-color var(--transition);
  }

  .form-field input:focus,
  .form-field select:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .form-field--checkbox {
    flex-direction: row;
    align-items: flex-start;
    gap: var(--space-s);
  }

  .form-field--checkbox input[type="checkbox"] {
    width: auto;
    flex-shrink: 0;
    margin-top: 3px;
    accent-color: var(--color-accent);
  }

  .form-field--checkbox label {
    font-size: var(--text-small);
    cursor: pointer;
  }

  .btn {
    display: block;
    width: 100%;
    padding: 1rem 2rem;
    text-decoration: none;
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.06em;
    border: none;
    cursor: pointer;
    text-align: center;
    transition: background var(--transition);
  }

  .btn-primary {
    background: var(--color-accent);
    color: #fff;
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--color-accent-hover);
  }

  .btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .registration-notice {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-style: italic;
    text-align: center;
  }

  .registration-closed {
    padding: var(--space-xl);
    border: 2px dashed rgba(28, 43, 58, 0.2);
    border-radius: var(--radius);
    text-align: center;
  }

  .closed-text {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    color: var(--color-text-muted);
    text-transform: uppercase;
    line-height: 1.2;
  }
</style>
