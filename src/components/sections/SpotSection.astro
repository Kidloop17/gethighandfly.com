---
import type { Lang } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---
<div class="stripe-coral" aria-hidden="true"></div>
<section id="spot">
  <div class="spot-container">
    <header class="reveal">
      <h2>{t('spot.heading')}</h2>
    </header>
    <div class="spot-content reveal">
      <div class="spot-text">
        <p>{t('spot.body')}</p>
        <div class="wind-block">
          <h3>{t('spot.wind.heading')}</h3>
          <p>{t('spot.wind.body')}</p>
        </div>
      </div>
      <div class="spot-visuals">
        <div class="placeholder-block video-placeholder">
          <div class="play-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" width="48" height="48" fill="none">
              <circle cx="24" cy="24" r="22" stroke="#E8522A" stroke-width="2"/>
              <polygon points="19,14 36,24 19,34" fill="#E8522A" />
            </svg>
          </div>
          <p>TODO: Spot video</p>
          <small>{t('spot.forecast.label')}</small>
        </div>
        <div class="placeholder-block map-placeholder">
          <svg viewBox="0 0 48 48" width="36" height="36" fill="none" aria-hidden="true">
            <circle cx="24" cy="20" r="8" stroke="#1A5276" stroke-width="2"/>
            <path d="M24 28 C24 28 10 40 10 44 H38 C38 40 24 28 24 28Z" fill="#1A5276" fill-opacity="0.25"/>
            <circle cx="24" cy="20" r="3" fill="#1A5276"/>
          </svg>
          <p>TODO: Map embed</p>
          <small>{t('spot.map.caption')}</small>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #spot {
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
    padding: var(--section-padding);
  }

  .spot-container {
    max-width: var(--container-width);
    margin: 0 auto;
  }

  header {
    margin-bottom: var(--space-l);
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    color: var(--color-text-on-dark);
    text-transform: uppercase;
  }

  .spot-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (max-width: 768px) {
    .spot-content {
      grid-template-columns: 1fr;
    }
  }

  .spot-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .spot-text p {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-text-on-dark);
    opacity: 0.85;
    line-height: var(--line-height-base);
  }

  .wind-block h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    color: var(--color-accent);
    text-transform: uppercase;
    margin-bottom: var(--space-s);
  }

  .spot-visuals {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .placeholder-block {
    border-radius: var(--radius);
    padding: var(--space-l);
    min-height: 200px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-s);
    text-align: center;
  }

  .video-placeholder {
    border: 2px solid var(--color-accent);
  }

  .map-placeholder {
    border: 2px solid var(--color-ocean);
  }

  .placeholder-block p {
    font-family: var(--font-body);
    color: var(--color-text-on-dark);
    opacity: 0.5;
    font-size: 1rem;
  }

  .placeholder-block small {
    font-family: var(--font-body);
    color: var(--color-text-on-dark);
    opacity: 0.35;
    font-size: var(--text-small);
  }

  .play-icon {
    margin-bottom: var(--space-xs);
  }
</style>
