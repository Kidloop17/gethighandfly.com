---
import type { Lang } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const PARTNERS = [
  { name: 'Kitenam', logo: '/partners/kitenam.png' },
  { name: 'Blue Shell Resort', logo: '/partners/blueshell.png' },
  { name: 'Extremelab', logo: '/partners/extremelab.png' },
  { name: 'Airush', logo: '/partners/Airush.png' },
];
---
<div class="stripe-ocean" aria-hidden="true"></div>
<section id="partners">
  <div class="partners-container">
    <header class="reveal">
      <h2>{t('partners.heading')}</h2>
    </header>
    <div class="logos-row reveal">
      {PARTNERS.map(p => (
        <div class="logo-card">
          <img src={p.logo} alt={p.name} loading="lazy" />
        </div>
      ))}
    </div>
    <div class="partners-cta reveal">
      <h3>{t('partners.cta.heading')}</h3>
      <p>{t('partners.cta.body')}</p>
      <a href="#footer" class="btn btn-ocean">{t('partners.cta.contact')}</a>
    </div>
  </div>
</section>

<style>
  #partners {
    background: var(--color-bg-alt);
    padding: var(--section-padding);
  }

  .partners-container {
    max-width: var(--container-width);
    margin: 0 auto;
  }

  header {
    margin-bottom: var(--space-l);
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    color: var(--color-text);
    text-transform: uppercase;
  }

  .logos-row {
    display: flex;
    gap: var(--space-m);
    flex-wrap: wrap;
    margin-bottom: var(--space-xl);
  }

  .logo-card {
    flex: 1;
    min-width: 160px;
    background: #fff;
    border-radius: var(--radius);
    padding: var(--space-m) var(--space-l);
    display: flex;
    align-items: center;
    justify-content: center;
    height: 90px;
    transition: opacity var(--transition), transform var(--transition);
  }

  .logo-card:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-card:hover {
      transform: none;
    }
  }

  .logo-card img {
    max-height: 58px;
    max-width: 180px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  @media (max-width: 640px) {
    .logos-row {
      grid-template-columns: 1fr 1fr;
      display: grid;
    }
    .logo-card {
      min-width: unset;
    }
  }

  .partners-cta {
    border-top: 1px solid rgba(26, 82, 118, 0.2);
    padding-top: var(--space-l);
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    max-width: 480px;
  }

  .partners-cta h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    color: var(--color-text);
    text-transform: uppercase;
  }

  .partners-cta p {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-text-muted);
    line-height: var(--line-height-base);
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    text-decoration: none;
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.06em;
    width: fit-content;
    transition: background var(--transition), border-color var(--transition);
  }

  .btn-ocean {
    background: var(--color-ocean);
    color: var(--color-text-on-dark);
    border: 2px solid var(--color-ocean);
  }

  .btn-ocean:hover {
    background: var(--color-ocean-hover);
    border-color: var(--color-ocean-hover);
  }
</style>
