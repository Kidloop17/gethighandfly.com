---
import type { Lang } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const TIERS = ['general', 'partner', 'media'] as const;
---
<section id="partners">
  <div class="partners-container">
    <header>
      <h2>{t('partners.heading')}</h2>
    </header>
    <div class="tiers">
      {TIERS.map(tier => (
        <div class="tier">
          <h3 class="tier-label">{t(`partners.tier.${tier}`)}</h3>
          <div class="logos-placeholder">
            <p>{t('partners.placeholder')}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="partners-cta">
      <h3>{t('partners.cta.heading')}</h3>
      <p>{t('partners.cta.body')}</p>
      <a href="#footer" class="btn btn-outline">{t('partners.cta.contact')}</a>
    </div>
  </div>
</section>
<style>
  #partners {
    padding: var(--space-xl) var(--space-l);
    background: color-mix(in srgb, var(--color-bg) 95%, var(--color-accent-2));
  }
  .partners-container {
    max-width: var(--container-max);
    margin: 0 auto;
  }
  header {
    margin-bottom: var(--space-l);
  }
  h2 {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
  }
  .tiers {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }
  .tier-label {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.6;
    margin-bottom: var(--space-m);
  }
  .logos-placeholder {
    border: 2px dashed color-mix(in srgb, var(--color-text) 15%, transparent);
    border-radius: 8px;
    padding: var(--space-l);
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .logos-placeholder p {
    opacity: 0.35;
    font-size: 0.875rem;
  }
  .partners-cta {
    border-top: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
    padding-top: var(--space-l);
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    max-width: 480px;
  }
  .partners-cta h3 {
    font-size: 1.25rem;
    font-weight: 700;
  }
  .partners-cta p {
    opacity: 0.8;
  }
  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    width: fit-content;
  }
  .btn-outline {
    border: 2px solid var(--color-accent);
    color: var(--color-accent);
  }
</style>
