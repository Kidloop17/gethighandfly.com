---
import type { Lang } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const TIERS = ['general', 'partner', 'media'] as const;

// Number of logo slots per tier
const TIER_SLOTS: Record<typeof TIERS[number], number> = {
  general: 1,
  partner: 2,
  media: 3,
};
---
<div class="stripe-ocean" aria-hidden="true"></div>
<section id="partners">
  <div class="partners-container">
    <header class="reveal">
      <h2>{t('partners.heading')}</h2>
    </header>
    <div class="tiers">
      {TIERS.map(tier => (
        <div class="tier reveal">
          <h3 class="tier-label">{t(`partners.tier.${tier}`)}</h3>
          <div class={`logos-row logos-row--${tier}`}>
            {Array.from({ length: TIER_SLOTS[tier] }).map(() => (
              <div class="logo-slot">
                <span class="logo-placeholder-text">TODO: logo</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="partners-cta reveal">
      <h3>{t('partners.cta.heading')}</h3>
      <p>{t('partners.cta.body')}</p>
      <a href="#footer" class="btn btn-ocean">{t('partners.cta.contact')}</a>
    </div>
  </div>
</section>

<style>
  #partners {
    background: var(--color-bg-alt);
    padding: var(--section-padding);
  }

  .partners-container {
    max-width: var(--container-width);
    margin: 0 auto;
  }

  header {
    margin-bottom: var(--space-l);
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    color: var(--color-text);
    text-transform: uppercase;
  }

  .tiers {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .tier-label {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-m);
  }

  .logos-row {
    display: flex;
    gap: var(--space-m);
    flex-wrap: wrap;
  }

  .logo-slot {
    flex: 1;
    min-width: 200px;
    height: 80px;
    border: 1px dashed var(--color-ocean);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-style var(--transition), background var(--transition);
    cursor: default;
  }

  .logo-slot:hover {
    border-style: solid;
    background: var(--color-bg);
  }

  .logo-placeholder-text {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-text-muted);
    opacity: 0.5;
  }

  /* General sponsor slot is taller */
  .logos-row--general .logo-slot {
    height: 120px;
    min-width: 300px;
  }

  .partners-cta {
    border-top: 1px solid rgba(26, 82, 118, 0.2);
    padding-top: var(--space-l);
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    max-width: 480px;
  }

  .partners-cta h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    color: var(--color-text);
    text-transform: uppercase;
  }

  .partners-cta p {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-text-muted);
    line-height: var(--line-height-base);
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    text-decoration: none;
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.06em;
    width: fit-content;
    transition: background var(--transition), border-color var(--transition);
  }

  .btn-ocean {
    background: var(--color-ocean);
    color: var(--color-text-on-dark);
    border: 2px solid var(--color-ocean);
  }

  .btn-ocean:hover {
    background: var(--color-ocean-hover);
    border-color: var(--color-ocean-hover);
  }
</style>
